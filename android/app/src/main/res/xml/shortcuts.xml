            android:action="android.intent.action.VIEW"
            android:targetPackage="io.github.jcartu.hermex"
            android:targetClass="io.github.jcartu.hermex.MainActivity"
            android:data="hermex-type-j://new-chat" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
